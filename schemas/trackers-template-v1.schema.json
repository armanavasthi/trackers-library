{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://trackers.example/schemas/trackers-template-v1.json","title":"Trackers reusable template v1","type":"object","additionalProperties":false,
  "required":["$schema","schemaVersion","kind","metadata","content"],
  "properties":{"$schema":{"type":"string","pattern":"^https://.+/schemas/trackers-template-v1\\.json$"},"schemaVersion":{"const":1},"kind":{"enum":["study-template","dsa-template","relative-plan-template","workspace-template"]},"metadata":{"$ref":"#/$defs/metadata"},"content":{"type":"object"}},
  "allOf":[{"if":{"properties":{"kind":{"const":"study-template"}}},"then":{"properties":{"content":{"$ref":"#/$defs/study"}}}},{"if":{"properties":{"kind":{"const":"dsa-template"}}},"then":{"properties":{"content":{"$ref":"#/$defs/dsa"}}}},{"if":{"properties":{"kind":{"const":"relative-plan-template"}}},"then":{"properties":{"content":{"$ref":"#/$defs/plan"}}}},{"if":{"properties":{"kind":{"const":"workspace-template"}}},"then":{"properties":{"content":{"$ref":"#/$defs/workspace"}}}}],
  "$defs":{
    "key":{"type":"string","minLength":1,"maxLength":80,"pattern":"^[a-z0-9][a-z0-9-]{0,79}$"},
    "text":{"type":"string","minLength":1,"maxLength":160},
    "metadata":{"type":"object","additionalProperties":false,"required":["id","version","title"],"properties":{"id":{"$ref":"#/$defs/key"},"version":{"type":"string","maxLength":120,"pattern":"^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},"title":{"$ref":"#/$defs/text"},"description":{"type":"string","minLength":1,"maxLength":2000},"levels":{"type":"array","maxItems":20,"items":{"$ref":"#/$defs/key"}},"subjects":{"type":"array","maxItems":20,"items":{"$ref":"#/$defs/key"}},"estimatedWeeks":{"type":"integer","minimum":1,"maximum":520},"author":{"$ref":"#/$defs/text"},"license":{"$ref":"#/$defs/text"}}},
    "httpUrl":{"type":"string","minLength":1,"maxLength":2048,"pattern":"^https?://[^\\s/@?#\\\\]+(?:[/?#][^\\s\\\\]*)?$"},
    "resource":{"type":"object","additionalProperties":false,"required":["label","url"],"properties":{"label":{"$ref":"#/$defs/text"},"url":{"$ref":"#/$defs/httpUrl"}}},
    "studyLeaf":{"type":"object","additionalProperties":false,"required":["key","name"],"properties":{"key":{"$ref":"#/$defs/key"},"name":{"$ref":"#/$defs/text"},"url":{"$ref":"#/$defs/httpUrl"},"estimatedMinutes":{"type":"integer","minimum":1,"maximum":1440},"resources":{"type":"array","maxItems":20,"items":{"$ref":"#/$defs/resource"}}}},
    "dsaLeaf":{"type":"object","additionalProperties":false,"required":["key","name"],"properties":{"key":{"$ref":"#/$defs/key"},"name":{"$ref":"#/$defs/text"},"difficulty":{"enum":["easy","medium","hard"]},"url":{"$ref":"#/$defs/httpUrl"},"estimatedMinutes":{"type":"integer","minimum":1,"maximum":1440},"resources":{"type":"array","maxItems":20,"items":{"$ref":"#/$defs/resource"}}}},
    "study":{"type":"object","additionalProperties":false,"required":["sections"],"properties":{"sections":{"type":"array","minItems":1,"maxItems":50,"items":{"type":"object","additionalProperties":false,"required":["key","name","topics"],"properties":{"key":{"$ref":"#/$defs/key"},"name":{"$ref":"#/$defs/text"},"topics":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["key","name","subtopics"],"properties":{"key":{"$ref":"#/$defs/key"},"name":{"$ref":"#/$defs/text"},"subtopics":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/studyLeaf"}}}}}}}}}},
    "dsa":{"type":"object","additionalProperties":false,"required":["sections"],"properties":{"sections":{"type":"array","minItems":1,"maxItems":50,"items":{"type":"object","additionalProperties":false,"required":["key","name","patterns"],"properties":{"key":{"$ref":"#/$defs/key"},"name":{"$ref":"#/$defs/text"},"patterns":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["key","name","problems"],"properties":{"key":{"$ref":"#/$defs/key"},"name":{"$ref":"#/$defs/text"},"problems":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/dsaLeaf"}}}}}}}}}},
    "plan":{"type":"object","additionalProperties":false,"required":["anchor","entries"],"properties":{"anchor":{"const":"user-selected-start-date"},"entries":{"type":"array","minItems":1,"maxItems":5000,"items":{"type":"object","additionalProperties":false,"required":["dayOffset","tracker","sectionKey","itemKey"],"properties":{"dayOffset":{"type":"integer","minimum":0,"maximum":365},"tracker":{"enum":["study","dsa"]},"sectionKey":{"$ref":"#/$defs/key"},"itemKey":{"$ref":"#/$defs/key"},"sectionName":{"$ref":"#/$defs/text"},"itemName":{"$ref":"#/$defs/text"},"estimatedMinutes":{"type":"integer","minimum":1,"maximum":1440},"note":{"type":"string","minLength":1,"maxLength":2000}}}}}},
    "workspace":{"type":"object","additionalProperties":false,"minProperties":1,"properties":{"study":{"$ref":"#/$defs/study"},"dsa":{"$ref":"#/$defs/dsa"},"plan":{"$ref":"#/$defs/plan"}}}
  }
}
